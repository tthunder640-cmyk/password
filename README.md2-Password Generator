import random
import string
print("Welcome to the Password Generator!")

length=int(input("Enter the total nimber of character in the password : "))

num_letters=int(input("Enter the number of latters in the password : "))
num_numbers=int(input("Enter the number of numbers in the passwrd: "))
num_symbols=int(input("Enter the number of the symbols in the passwrd: "))

if length !=(num_letters+num_numbers+num_symbols):
    print("Invalid input. The sum of letters, numbers and symbols doesn't match the passwrd length.")
else:
    tetters=string.ascii_letters
    numbers=string.digits
    symbols=string.punctuation


    password_chars=(
        random.choices(tetters,k=num_letters)+
        random.choices(numbers,k=num_numbers)+
        random.choices(symbols,k=num_symbols)
    )

    random.shuffle(password_chars)

    password="".join(password_chars)
    print("Generated Password: ",password)






