import re
from os import system
def clear():
    system('cls')

print("Welcome to 1-Password Strength Checker ")
password=input("Enter the password plses : ")
if len(password)<=4:
    print("The password is very bad")
else:
    password_len=  len(password)>=8
    later_1=bool(re.search(r"[A-Z]",password))
    later_2=bool(re.search(r"[a-z]",password))
    number=bool(re.search(r"[0-9]",password))
    hash=bool(re.search(r"\W",password))

    sum_vale=password_len+later_1+later_2+number+hash
    if sum_vale==1:
        clear()
        print("Sorry\nYour password is \n#############\nvery Terrible\n#############")
    elif sum_vale==2:
        clear()
        print("Your password is \n########\n  bad\n######## ")
    elif sum_vale==3:
        clear()
        print("Your password Average\n############\n  (so-so)\n############")
    elif sum_vale==4:
        clear()
        print("Your password is \n##############\n ( Very Good )\n##############")
    else:
        clear()
        print("Your password is \n##################\n(Super password )\n##################\n I love it")







